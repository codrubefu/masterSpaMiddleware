APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# API Secret for middleware authentication
API_SECRET=your-secure-api-secret-here

# Comenzi website (vezi config/orders.php)
# Creeaza nota de plata (trznp) si factura (trzfact) pentru comenzi
CREATE_NP_AND_INVOICE=false
ORDER_VAT_RATE=11
ORDER_IDFIRMA=1
ORDER_NR_GEST=1
CLIENT_NAME="Mirage MedSPA Hotel"
ORDER_HOTEL_MAIL_SUBJECT="Rezervarea dumneavoastra de la Noblesse"
ORDER_HOTEL_MAIL_STAFF=codrut_befu@yahoo.com,support@masterspa.ro
ORDER_VOUCHER_MAIL_STAFF=codrut_befu@yahoo.com,mgrus@acordnet.ro
# true = emailurile merg pe coada (necesita queue:work daca QUEUE_CONNECTION != sync)
ORDER_MAIL_QUEUE=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
